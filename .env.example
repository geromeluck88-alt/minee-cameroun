# ──────────────────────────────────────────────
# MINEE Backend — Configuration d'environnement
# Copiez ce fichier en ".env" puis adaptez les valeurs
# ──────────────────────────────────────────────

# Connexion MySQL (XAMPP par défaut : utilisateur "root", pas de mot de passe)
# Format : mysql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="mysql://root:@127.0.0.1:3306/minee"

# Secret utilisé pour signer les tokens JWT (mettez une valeur aléatoire en production)
JWT_SECRET="change_moi_en_une_longue_chaine_aleatoire"

# Durée de validité du token
JWT_EXPIRES_IN="7d"

# Port du serveur backend
PORT=4000

# URL autorisée pour le frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# ──────────────────────────────────────────────
# Assistant IA (base vectorielle + chat)
# ──────────────────────────────────────────────

# Clé API Anthropic — https://console.anthropic.com/settings/keys
# Utilisée pour générer les réponses du chat (RAG)
ANTHROPIC_API_KEY="sk-ant-..."

# Modèle Claude utilisé par l'assistant
ANTHROPIC_MODEL="claude-sonnet-5"

# Clé API Voyage AI — https://dashboard.voyageai.com/
# Utilisée pour générer les embeddings (base vectorielle)
JINA_API_KEY="jina_bb97e35571b240ad90a6d1881f28fd2aO56TFY5sf4pyzWSa3OMP8JnZuEZS"

# Modèle d'embedding Voyage
JINA_MODEL="jina-embeddings-v3"

